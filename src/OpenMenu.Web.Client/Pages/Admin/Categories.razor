@page "/admin/categories"
@attribute [Authorize]
@layout Layout.AdminLayout
@rendermode InteractiveAuto
@inject IAdminApi Api
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation

<PageTitle>Categories</PageTitle>

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">@(L["Categories"])</h1>
    <NavLink href="/admin/categories/new" class="btn btn-primary btn-sm">@(L["NewCategory"])</NavLink>
</div>

@if (_categories is null)
{
    <span class="loading loading-dots loading-md"></span>
}
else
{
    <table class="table table-zebra bg-base-200 rounded-box">
        <thead>
            <tr>
                <th>@(L["Name"])</th>
                <th>@(L["Order"])</th>
                <th>@(L["Visible"])</th>
                <th>@(L["Items"])</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in _categories)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.SortOrder</td>
                    <td>@(category.IsVisible ? L["Yes"].Value : L["No"].Value)</td>
                    <td>@category.ItemsCount</td>
                    <td class="text-right">
                        <NavLink href="@($"admin/categories/{category.Id}/edit")" class="btn btn-ghost btn-xs">@(L["Edit"])</NavLink>
                        <button class="btn btn-error btn-xs" @onclick="() => DeleteAsync(category)">@(L["Delete"])</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private OpenMenu.Domain.CategoryDto[]? _categories;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() =>
        _categories = await Api.GetCategoriesAsync();

    private async Task DeleteAsync(OpenMenu.Domain.CategoryDto category)
    {
        if ((await Api.DeleteCategoryAsync(category.Id)).Success)
        {
            await LoadAsync();
        }
    }
}
