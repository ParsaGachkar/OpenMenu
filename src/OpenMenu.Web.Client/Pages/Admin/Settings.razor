@using OpenMenu.Application.Shared
@page "/admin/settings"
@attribute [Authorize(Roles = "Admin")]
@layout Layout.AdminLayout
@rendermode InteractiveAuto
@inject IAdminApi Api
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(L["RestaurantSettings"])</PageTitle>

<h1 class="text-2xl font-bold mb-6">@(L["RestaurantSettings"])</h1>

<div class="max-w-lg">
    @if (_savedFromQuery)
    {
        <div role="alert" class="alert alert-success mb-4"><span>@(L["SettingsSaved"])</span></div>
    }
    @if (_error is not null)
    {
        <div role="alert" class="alert alert-error mb-4"><span>@_error</span></div>
    }

    <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="SettingsForm">
        <DataAnnotationsValidator />
        <div class="card bg-base-200 shadow-md">
            <div class="card-body gap-4">
                <label class="form-control w-full">
                    <span class="label-text mb-1">@(L["SettingsName"]) <span class="text-error">*</span></span>
                    <InputText @bind-Value="_model.Name" class="input input-bordered w-full" maxlength="200" />
                </label>
                <ValidationMessage For="() => _model.Name" class="text-error text-sm" />

                <label class="form-control w-full">
                    <span class="label-text mb-1">@(L["SettingsDescription"])</span>
                    <InputTextArea @bind-Value="_model.Description" class="textarea textarea-bordered w-full" rows="3" maxlength="2000" />
                </label>

                <div class="form-control w-full">
                    <span class="label-text mb-1">@(L["LogoUrl"]) (≤ 2 MB)</span>
                    <InputFile OnChange="OnLogoSelected" accept="image/*" class="file-input file-input-bordered w-full" />
                    @if (!string.IsNullOrEmpty(_model.LogoUrl))
                    {
                        <div class="mt-2 flex items-center gap-3">
                            <img src="@_model.LogoUrl" alt="Logo" class="w-14 h-14 rounded-full object-cover" />
                            <button type="button" class="btn btn-ghost btn-xs" @onclick="RemoveLogo">@(L["RemoveLogo"])</button>
                        </div>
                    }
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <label class="form-control w-full">
                        <span class="label-text mb-1">@(L["Currency"]) <span class="text-error">*</span></span>
                        <InputSelect @bind-Value="_model.Currency" class="select select-bordered w-full">
                            @foreach (var (currency, name) in Currencies)
                            {
                                <option value="@currency">@currency — @name</option>
                            }
                        </InputSelect>
                    </label>
                    <label class="form-control w-full">
                        <span class="label-text mb-1">@(L["Theme"])</span>
                        <InputSelect @bind-Value="_model.Theme" class="select select-bordered w-full">
                            @foreach (var theme in Themes)
                            {
                                <option value="@theme">@theme</option>
                            }
                        </InputSelect>
                    </label>
                </div>

                <label class="form-control w-full">
                    <span class="label-text mb-1">@(L["PrimaryColorOverride"])</span>
                    <div class="flex items-center gap-3">
                        <input type="color" value="@_primaryColor" @onchange="OnPrimaryColorChanged" class="input input-bordered w-16 p-1" />
                        <span class="text-sm text-base-content/60">@(L["KeepThemeColorHint"])</span>
                        @if (_colorTouched)
                        {
                            <button type="button" class="btn btn-ghost btn-xs" @onclick="ResetPrimaryColor">@(L["Reset"])</button>
                        }
                    </div>
                </label>

                <div class="divider my-1"></div>

                <h2 class="font-semibold">@(L["CulturesHeading"])</h2>

                <label class="form-control w-full">
                    <span class="label-text mb-1">@(L["DefaultCulture"]) <span class="text-error">*</span></span>
                    <InputSelect @bind-Value="_model.DefaultCulture" class="select select-bordered w-full">
                        @foreach (var culture in _model.EnabledCultures)
                        {
                            <option value="@culture">@NativeName(culture)</option>
                        }
                    </InputSelect>
                    <span class="label-text-alt text-base-content/60">@(L["DefaultCultureHint"])</span>
                </label>

                <div class="form-control w-full">
                    <span class="label-text mb-1">@(L["EnabledCultures"])</span>
                    <div class="flex flex-col gap-1">
                        @foreach (var (culture, native) in AllCultures)
                        {
                            <label class="label cursor-pointer justify-start gap-3">
                                <input type="checkbox" class="toggle toggle-primary toggle-sm"
                                       checked="@_model.EnabledCultures.Contains(culture)"
                                       @onchange="e => ToggleCulture(culture, (bool)(e.Value ?? false))" />
                                <span class="label-text">@native <span class="opacity-50">(@culture)</span></span>
                            </label>
                        }
                    </div>
                    <span class="label-text-alt text-base-content/60">@(L["EnabledCulturesHint"])</span>
                </div>

                <div class="card-actions justify-end mt-2">
                    <button type="submit" class="btn btn-primary" disabled="@_saving">@(L["Save"])</button>
                </div>
            </div>
        </div>
    </EditForm>

    @* QR code of the public menu URL — print it and put it on the tables. *@
    <div class="card bg-base-200 shadow-md mt-6" data-qr>
        <div class="card-body gap-3">
            <h2 class="card-title text-base">@(L["QrHeading"])</h2>
            <p class="text-sm text-base-content/60">@(L["QrHint"])</p>
            <img src="/qr/menu" alt="@(L["QrHeading"])" class="w-48 h-48" />
        </div>
    </div>
</div>

@code {
    // Shared list (also offered per translation currency in the item editor).
    // TOMAN is not ISO 4217: Iranian restaurants quote prices in Toman, and the
    // admin is responsible for entering menu prices in the selected unit.
    private static (string Code, string Name)[] Currencies => CurrencyOptions.All;

    // All DaisyUI built-in themes (daisyui.com/docs/themes).
    private static readonly string[] Themes =
    [
        "light", "dark", "cupcake", "bumblebee", "emerald", "corporate", "synthwave",
        "retro", "cyberpunk", "valentine", "halloween", "garden", "forest", "aqua",
        "lofi", "pastel", "fantasy", "wireframe", "black", "luxury", "dracula",
        "cmyk", "autumn", "business", "acid", "lemonade", "night", "coffee",
        "winter", "dim", "nord", "sunset",
    ];

    // Every culture the app ships content for; the admin picks a subset.
    private static readonly (string Culture, string Native)[] AllCultures =
    [
        ("en", "English"), ("fa", "فارسی"), ("tr", "Türkçe"), ("ar", "العربية"),
    ];

    private SettingsFormModel _model = new();
    private string _primaryColor = "#570df8";
    private bool _colorTouched;
    private bool _savedFromQuery;
    private string? _error;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        // Standard save-then-redirect feedback: /admin/settings?saved=1 is set by
        // SaveAsync, so the confirmation survives the full reload that applies the theme.
        var uri = new Uri(Navigation.Uri);
        _savedFromQuery = uri.Query.Contains("saved=1");

        var settings = await Api.GetSettingsAsync();
        if (settings is not null)
        {
            _model = new SettingsFormModel
            {
                Name = settings.Name,
                Description = settings.Description ?? string.Empty,
                LogoUrl = settings.LogoUrl,
                Currency = settings.Currency,
                Theme = settings.Theme,
                PrimaryColor = settings.PrimaryColor,
                DefaultCulture = SupportedCultures.Normalize(settings.DefaultCulture),
                EnabledCultures = SupportedCultures.SplitEnabled(settings.EnabledCultures, settings.DefaultCulture).ToList(),
            };
            _primaryColor = settings.PrimaryColor ?? "#570df8";
            _colorTouched = settings.PrimaryColor is not null;
        }

        // The default culture must always stay among the enabled ones.
        if (_model.EnabledCultures.Count == 0)
        {
            _model.EnabledCultures = ["en"];
        }
        if (!_model.EnabledCultures.Contains(_model.DefaultCulture))
        {
            _model.DefaultCulture = _model.EnabledCultures[0];
        }
    }

    private static string NativeName(string culture) =>
        AllCultures.FirstOrDefault(c => c.Culture == culture).Native;

    private void OnPrimaryColorChanged(ChangeEventArgs e)
    {
        _primaryColor = e.Value?.ToString() ?? _primaryColor;
        _colorTouched = true;
    }

    private void ResetPrimaryColor()
    {
        _colorTouched = false;
        _model.PrimaryColor = null;
    }

    private void ToggleCulture(string culture, bool enabled)
    {
        if (enabled)
        {
            if (!_model.EnabledCultures.Contains(culture))
            {
                _model.EnabledCultures.Add(culture);
            }
        }
        else if (_model.EnabledCultures.Count > 1) // never disable the last one
        {
            _model.EnabledCultures.Remove(culture);
            if (_model.DefaultCulture == culture)
            {
                _model.DefaultCulture = _model.EnabledCultures[0];
            }
        }
    }

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        try
        {
            const long maxFileSize = 2 * 1024 * 1024;
            await using var stream = e.File.OpenReadStream(maxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var result = await Api.UploadImageAsync(ms.ToArray(), e.File.ContentType, e.File.Name);
            if (result is null)
            {
                _error = L["LogoUploadFailed"].Value;
                return;
            }

            _model.LogoUrl = result.Url;
        }
        catch
        {
            _error = L["LogoUploadFailed"].Value;
        }
    }

    private void RemoveLogo() => _model.LogoUrl = null;

    private async Task SaveAsync()
    {
        _error = null;
        _saving = true;
        try
        {
            _model.PrimaryColor = _colorTouched ? _primaryColor : null;
            var result = await Api.SaveSettingsAsync(new SettingsInput(
                _model.Name, _model.Description, _model.LogoUrl,
                _model.Currency, _model.Theme, _model.PrimaryColor,
                _model.DefaultCulture, string.Join(",", _model.EnabledCultures)));

            if (result.Success)
            {
                // The theme/color is baked into the server-rendered <html> tag,
                // so a full reload applies it; ?saved=1 keeps the confirmation visible.
                Navigation.NavigateTo("/admin/settings?saved=1", forceLoad: true);
            }
            else
            {
                _error = result.Error;
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class SettingsFormModel
    {
        [Required(ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.FieldRequired)), StringLength(200, ErrorMessageResourceType = typeof(SharedResource), ErrorMessageResourceName = nameof(SharedResource.FieldTooLong))]
        public string Name { get; set; } = string.Empty;

        [StringLength(2000)]
        public string? Description { get; set; }

        public string? LogoUrl { get; set; }

        [Required]
        public string Currency { get; set; } = "USD";

        [Required]
        public string Theme { get; set; } = "light";

        public string? PrimaryColor { get; set; }

        [Required]
        public string DefaultCulture { get; set; } = "en";

        public List<string> EnabledCultures { get; set; } = ["en", "fa", "tr", "ar"];
    }
}
