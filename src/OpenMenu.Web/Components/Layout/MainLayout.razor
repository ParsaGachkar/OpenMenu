@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> L

<div class="min-h-screen flex flex-col bg-base-100">
    <header class="navbar bg-base-200 px-4">
        <div class="navbar-start">
            <NavLink href="/" class="btn btn-ghost text-lg font-semibold">OpenMenu</NavLink>
        </div>
        <div class="navbar-end gap-2">
            <LanguageDropdown @rendermode="InteractiveServer" />
            <NavLink href="/login" class="btn btn-ghost btn-sm">@(L["StaffLogin"])</NavLink>
        </div>
    </header>

    <main class="flex-1 w-full max-w-3xl mx-auto px-4 py-6">
        @Body
    </main>

    <footer class="footer footer-center bg-base-200 text-base-content/60 py-4 text-sm">
        <p>@(L["PoweredByOpenMenu"])</p>
    </footer>
</div>
