@page "/forbidden"
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(L["AccessDenied"])</PageTitle>

<div class="max-w-md mx-auto my-16 text-center">
    <h1 class="text-3xl font-bold mb-3">403</h1>
    <p class="text-base-content/70 mb-6">@(L["AccessDeniedMessage"])</p>
    <NavLink href="/" class="btn btn-primary">@(L["BackToMenu"])</NavLink>
</div>
