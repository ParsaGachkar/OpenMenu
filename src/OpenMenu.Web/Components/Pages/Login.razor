@page "/login"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(L["SignIn"])</PageTitle>

<div class="max-w-sm mx-auto my-10">
    <h1 class="text-2xl font-bold text-center mb-6">@(L["LoginHeading"])</h1>

    <div class="card bg-base-200 shadow-md">
        <div class="card-body">
            @if (_error is not null)
            {
                <div role="alert" class="alert alert-error text-sm py-2">
                    <span>@_error</span>
                </div>
            }

            <EditForm Model="Model" FormName="login" OnValidSubmit="OnSubmit">
                <DataAnnotationsValidator />
                <label class="form-control w-full mb-3">
                    <span class="label-text mb-1">@(L["Username"])</span>
                    <InputText @bind-Value="Model!.Username" class="input input-bordered w-full" autocomplete="username" />
                </label>
                <label class="form-control w-full mb-4">
                    <span class="label-text mb-1">@(L["Password"])</span>
                    <InputText type="password" @bind-Value="Model!.Password" class="input input-bordered w-full" autocomplete="current-password" />
                </label>
                <button type="submit" class="btn btn-primary w-full">@(L["SignIn"])</button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private LoginModel? Model { get; set; }

    private string? _error;

    protected override void OnInitialized() => Model ??= new();

    private async Task OnSubmit()
    {
        var principal = await AuthService.SignInAsync(Model!.Username, Model.Password);
        if (principal is null)
        {
            // Generic message: does not reveal whether the username exists.
            _error = L["InvalidUsernameOrPassword"];
            return;
        }

        await (HttpContext ?? throw new InvalidOperationException("HttpContext is unavailable."))
            .SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal);
        Navigation.NavigateTo("/admin", forceLoad: true);
    }

    private sealed class LoginModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
