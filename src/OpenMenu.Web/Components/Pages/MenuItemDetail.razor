@page "/menu/item/{Id:int}"
@using OpenMenu.Application.Shared
@using OpenMenu.Web.Components.Shared
@inject AppDbContext Db
@inject IStringLocalizer<SharedResource> L
@attribute [StreamRendering]

<PageTitle>@(Item is null ? L["Menu"] : $"{NameOf(Item)} — {Settings?.Name}")</PageTitle>

@if (Item is null)
{
    <div class="alert alert-warning">
        <span>@(L["ItemNotFound"])</span>
    </div>
}
else
{
    <div class="max-w-2xl mx-auto">
        <NavLink href="@BackUrl" class="btn btn-ghost btn-sm mb-4">
            ← @(L["BackToMenu"])
        </NavLink>

        <article class="card bg-base-200 shadow-sm">
            @* Gallery: the active slide lives in the main box; the video is a
               first-class slide. Prerendered SSR shows slide 0 immediately;
               the island takes over once its circuit connects. *@
            <GalleryDetail @rendermode="RenderMode.InteractiveServer" Name="@NameOf(Item)" Slides="@Slides" />

            <div class="card-body gap-4">
                <div class="flex items-start justify-between gap-3">
                    <h1 class="text-2xl font-bold">@NameOf(Item)</h1>
                    <span data-price class="text-xl font-semibold whitespace-nowrap">
                        @(PriceFormatter.Format(PriceOf(Item), CurrencyOf(Item) ?? Settings?.Currency))
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(DescriptionOf(Item)))
                {
                    <p class="text-base-content/70">@DescriptionOf(Item)</p>
                }

                @if (!Item.IsAvailable)
                {
                    <div><span class="badge badge-ghost">@(L["SoldOut"])</span></div>
                }

                @if (Category is not null)
                {
                    <div class="text-sm text-base-content/60">
                        @(L["Category"]): <span class="font-medium">@NameOf(Category)</span>
                    </div>
                }
            </div>
        </article>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private RestaurantSettings? Settings;
    private MenuItem? Item;
    private Category? Category;
    private List<GalleryDetail.GallerySlide> Slides = [];
    private string BackUrl = "/";

    protected override async Task OnInitializedAsync()
    {
        Settings = await Db.RestaurantSettings.AsNoTracking().FirstOrDefaultAsync();

        Item = await Db.MenuItems
            .AsNoTracking()
            .Include(i => i.Translations)
            .Include(i => i.Images)
            .Include(i => i.Video)
            .FirstOrDefaultAsync(i => i.Id == Id);

        if (Item is not null)
        {
            // Video first, then the ordered photos: the video participates in
            // the gallery instead of rendering separately under the images.
            if (Item.Video is not null)
            {
                Slides.Add(new GalleryDetail.GallerySlide(Item.Video.Url, IsVideo: true));
            }

            Slides.AddRange(GalleryOf(Item)
                .Select(url => new GalleryDetail.GallerySlide(url, IsVideo: false)));

            Category = await Db.Categories
                .AsNoTracking()
                .Include(c => c.Translations)
                .FirstOrDefaultAsync(c => c.Id == Item.CategoryId);
        }

        _culture = CultureInfo.CurrentUICulture.Name;
    }

    private string? _culture;

    private string NameOf(MenuItem item) =>
        FindTranslation(item.Translations)?.Name ?? item.Name;

    private string NameOf(Category category) =>
        FindTranslation(category.Translations)?.Name ?? category.Name;

    private string DescriptionOf(MenuItem item) =>
        FindTranslation(item.Translations)?.Description ?? item.Description ?? string.Empty;

    private decimal PriceOf(MenuItem item) =>
        FindTranslation(item.Translations)?.Price ?? item.Price;

    /// <summary>Currency of the per-culture price override, when set.</summary>
    private string? CurrencyOf(MenuItem item) =>
        FindTranslation(item.Translations)?.Currency;

    private MenuItemTranslation? FindTranslation(List<MenuItemTranslation> translations)
    {
        if (string.IsNullOrEmpty(_culture)) return null;
        return translations.FirstOrDefault(t => t.Culture == _culture)
            ?? translations.FirstOrDefault(t => _culture.StartsWith(t.Culture + "-"));
    }

    private CategoryTranslation? FindTranslation(List<CategoryTranslation> translations)
    {
        if (string.IsNullOrEmpty(_culture)) return null;
        return translations.FirstOrDefault(t => t.Culture == _culture)
            ?? translations.FirstOrDefault(t => _culture.StartsWith(t.Culture + "-"));
    }

    /// <summary>Primary image first, then the ordered gallery images.</summary>
    private static List<string> GalleryOf(MenuItem item)
    {
        var urls = new List<string>();
        if (!string.IsNullOrEmpty(item.ImageUrl))
        {
            urls.Add(item.ImageUrl);
        }
        urls.AddRange(item.Images.OrderBy(i => i.SortOrder).ThenBy(i => i.Id).Select(i => i.Url));
        return urls;
    }
}
