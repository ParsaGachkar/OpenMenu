# PostgreSQL password used by both the db and app containers.
POSTGRES_PASSWORD=change-me

# Host port the app is published on.
APP_PORT=8088

# Host port for PostgreSQL (useful for psql/admin tools).
POSTGRES_PORT=5433

# Initial admin account, created on first startup (only if the user doesn't exist).
OPENMENU_ADMIN_USERNAME=admin
OPENMENU_ADMIN_PASSWORD=change-me-too

# Set to false to skip the demo categories/menu items.
OPENMENU_SEED_DEMO_DATA=true
